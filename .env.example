# The backend reads this repo-level `.env` too, but `server/.env` wins when keys overlap.
# Keep frontend `VITE_*` variables here and prefer server-only secrets in `server/.env`.

# Preferred: keep the Groq key server-side so it is not exposed in the browser.
GROQ_API_KEY=your_groq_api_key_here

# Optional fallback for legacy client setups only. Prefer GROQ_API_KEY above.
# VITE_GROQ_API_KEY=your_groq_api_key_here

# Optional model override used by the local Vite Groq proxy.
# `llama-3.3-70b-versatile` is the compatibility-first default for this project.
# If your Groq account supports it well, you can try `llama3-8b-8192` for lower latency.
GROQ_MODEL=llama-3.3-70b-versatile

# Optional external proxy URL if you already have your own backend endpoint.
# VITE_GROQ_PROXY_URL=https://your-backend.example.com/api/groq-chat

# Frontend API and Firebase client configuration
# Vite uses `VITE_FIREBASE_*`. CRA uses the same values with a `REACT_APP_FIREBASE_*` prefix.
VITE_API_BASE_URL=http://localhost:5000/api
CLIENT_URL=http://localhost:5173,https://capstone-project-1-yqto.onrender.com
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
# Use the exact bucket shown in Firebase Console. Newer projects often use
# `your-project.firebasestorage.app`, while older ones may still use `your-project.appspot.com`.
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Optional backend mail settings when you prefer a single repo-level .env.
# The backend also reads `server/.env`, which can override these values.
MAIL_DELIVERY_MODE=gmail-api
GMAIL_USER=yourgmail@gmail.com
GMAIL_CLIENT_ID=your_google_oauth_client_id
GMAIL_CLIENT_SECRET=your_google_oauth_client_secret
GMAIL_REFRESH_TOKEN=your_google_oauth_refresh_token
GMAIL_FROM_EMAIL=yourgmail@gmail.com
EMAIL_FROM_NAME=Charming Fur-fection Pet Care
