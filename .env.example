# The backend reads this repo-level `.env` too, but `server/.env` wins when keys overlap.
# Keep frontend `VITE_*` variables here and prefer server-only secrets in `server/.env`.

# Preferred: keep the Groq key server-side so it is not exposed in the browser.
GROQ_API_KEY=your_groq_api_key_here

# Optional fallback for legacy client setups only. Prefer GROQ_API_KEY above.
# VITE_GROQ_API_KEY=your_groq_api_key_here

# Optional model override used by the local Vite Groq proxy.
# `llama-3.3-70b-versatile` is the active Llama model for this project.
GROQ_MODEL=llama-3.3-70b-versatile

# Optional external proxy URL if you already have your own backend endpoint.
# VITE_GROQ_PROXY_URL=https://your-backend.example.com/api/groq-chat

# Frontend API and Firebase client configuration
# Vite uses `VITE_FIREBASE_*`. CRA uses the same values with a `REACT_APP_FIREBASE_*` prefix.
# Production uses the live Render backend via .env.production.
# Optional local override; include /api (bare backend origins are normalized too).
VITE_API_URL=
VITE_API_BASE_URL=
CLIENT_URL=http://localhost:5173,https://capstone-project-1-yqto.onrender.com
FRONTEND_URL=http://localhost:5173
FRAUD_GEO_LOOKUP_URL=https://api.ipapi.is/?q={ip}&key={api_key}
FRAUD_GEO_LOOKUP_API_KEY=your_ipapi_is_api_key
# SEA and Hong Kong always pass; provider errors and unknown geography fail open.
# Optional verified VPN/hosting CIDRs apply only outside the regional whitelist.
SESSION_BLOCKED_NETWORK_CIDRS=
VITE_FIREBASE_API_KEY=AIzaSyD_9_THiwlQdG3PUSQOk9SElIwc5b0AiI4
VITE_FIREBASE_AUTH_DOMAIN=capstoneproject-client.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=capstoneproject-client
# Official Firebase Storage bucket.
VITE_FIREBASE_STORAGE_BUCKET=capstoneproject-client.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=397187477635
VITE_FIREBASE_APP_ID=1:397187477635:web:eb32781779f3375e832bb6
# Leave blank until an Analytics measurement ID for the official project is supplied.
VITE_FIREBASE_MEASUREMENT_ID=

# Optional backend mail settings when you prefer a single repo-level .env.
# The backend also reads `server/.env`, which can override these values.
MAIL_DELIVERY_MODE=smtp
EMAIL_FROM_NAME=Charming Fur-fection Pet Care
EMAIL_USER=charmingfurfectionpetcare2@gmail.com
EMAIL_PASS=your_16_character_gmail_app_password
EMAIL_FROM=charmingfurfectionpetcare2@gmail.com
