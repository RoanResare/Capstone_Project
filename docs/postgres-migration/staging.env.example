# Copy these entries into ignored local environment files / private host settings.
# Both app data providers must be PostgreSQL for a staging rehearsal.
DATABASE_PROVIDER=postgres
VITE_DATABASE_PROVIDER=postgres
# Supabase Connect: choose Transaction pooler (shared IPv4 pooler, port 6543).
# Keep the project-qualified username, pooler host, password and TLS query exactly
# as Supabase provides them. This Node adapter uses explicit SQL transactions.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=verify-full
DATABASE_POOL_MAX=5
MIGRATION_TARGET=staging
# Supabase project Settings > API / Connect; this is NOT your Express /api URL.
VITE_SUPABASE_URL=https://YOUR_STAGING_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_STAGING_PUBLISHABLE_KEY
# Backend only: legacy Supabase JWT signing secret (HS256).
# If the project disallows legacy signing, configure a supported signing method
# before enabling this implementation; never substitute an sb_secret_ API key.
SUPABASE_JWT_SECRET=YOUR_STAGING_JWT_SIGNING_SECRET
# Server-side verifier for Supabase Auth access tokens; publishable/anon key only.
SUPABASE_URL=https://YOUR_STAGING_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_STAGING_PUBLISHABLE_KEY
# Backend only: required for admin user lookup, custom Resend verification/reset
# links, and issuing the post-OTP Supabase session. Never use a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=YOUR_STAGING_SECRET_KEY
