rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isPortalAdmin() {
      return request.auth != null && request.auth.token.role == 'admin';
    }

    // USERS COLLECTION
    match /users/{userId} {
      // Pinapayagan ang user na i-read/update ang sarili nilang profile sa pamamagitan ng UID
      allow read: if request.auth != null && (request.auth.uid == userId || isPortalAdmin());
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId
        || isPortalAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'photoURL',
            'profilePhotoModerationId',
            'updatedAt'
          ]);
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /users {
      // Pinapayagan ang authenticated users na mag-search/read ng user profiles (hal. login by email/username)
      allow read: if request.auth != null;
    }

    // CHATBOT FAQS & SERVICES (Publicly readable for fast chatbot lookup)
    match /chatbot_faqs/{document=**} {
      allow read: if true;
    }

    match /services/{document=**} {
      allow read: if true;
    }

    // OTHER COLLECTIONS (Appointments, Pets, Notifications, etc.)
    match /appointments/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /pets/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /notifications/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /photoModeration/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /customers/{document=**} {
      allow read, write: if request.auth != null;
    }

    // BLOCK EVERYTHING ELSE BY DEFAULT
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
