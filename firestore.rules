rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isActiveAccount() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus == 'active';
    }

    match /users/{userId} {
      allow read: if isActiveAccount() && request.auth.uid == userId;
      allow write: if isActiveAccount() && (
        request.auth.uid == userId ||
        request.auth.token.admin == true ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fraudStatus', 'fraudReason', 'updatedAt'])
      );
    }

    match /usernames/{username} {
      allow read: if true;
      allow write: if isActiveAccount();
    }

    match /chatbot_faqs/{document=**} {
      allow read: if true;
    }

    match /servicePricelists/{category} {
      allow read: if isActiveAccount();
      allow write: if false;
    }

    match /services/{document=**} {
      allow read: if true;
    }

    match /appointments/{appointmentId} {
      allow read, write: if isActiveAccount();
    }

    match /pets/{petId} {
      allow read: if isActiveAccount();
      // Validated API writes enforce ownership and multilingual text moderation.
      // Direct SDK writes would bypass the server-side filter.
      allow create, update: if false;
      allow delete: if isActiveAccount();
    }

    match /notifications/{document=**} {
      allow read, write: if isActiveAccount();
    }

    match /customers/{document=**} {
      allow read, write: if isActiveAccount();
    }

    match /schedules/{document=**} {
      allow read, write: if isActiveAccount();
    }

    match /slot_management/{document=**} {
      allow read, write: if isActiveAccount();
    }

    match /lowCostKaponPromo/{promoId} {
      allow read, write: if isActiveAccount();
    }

    match /revoked_tokens/{tokenId} {
      allow read, write: if isActiveAccount();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
