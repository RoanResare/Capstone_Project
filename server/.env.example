# The backend loads both the repo root `.env` and `server/.env`.
# Values in `server/.env` override the repo root when the same key exists.

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Optional alternative to the FIREBASE_* values below.
# If set, the server will load the service account JSON from this path.
# FIREBASE_SERVICE_ACCOUNT_PATH=config/firebase-adminsdk-fbsvc-d8b9ae552c.json
# GOOGLE_APPLICATION_CREDENTIALS=server/config/firebase-service-account.json

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_WEB_API_KEY=your_firebase_web_api_key

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=12h
OTP_TICKET_SECRET=replace_with_a_second_long_random_secret
OTP_TICKET_EXPIRES_IN=10m
OTP_HASH_SECRET=replace_with_a_third_long_random_secret
PASSWORD_HASH_PEPPER=replace_with_a_fourth_long_random_secret
PASSWORD_RESET_URL=http://localhost:5173/reset-password

OTP_TTL_MINUTES=5
OTP_CODE_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_TTL_MINUTES=30

MAIL_DELIVERY_MODE=smtp
EMAIL_USER=yourgmail@gmail.com
# Paste the 16-character Gmail App Password without spaces. The loader also strips spaces safely.
EMAIL_PASS=your_16_character_gmail_app_password
EMAIL_FROM=yourgmail@gmail.com
EMAIL_FROM_NAME=Charming Fur-fection Pet Care

# Optional explicit SMTP overrides. Gmail works without these defaults.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=yourgmail@gmail.com
# SMTP_PASS=your_16_character_gmail_app_password
# SMTP_FROM_NAME=Charming Fur-fection Pet Care
# SMTP_FROM_EMAIL=yourgmail@gmail.com
