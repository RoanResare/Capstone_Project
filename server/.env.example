# The backend loads both the repo root `.env` and `server/.env`.
# Values in `server/.env` override the repo root when the same key exists.

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# The server loads credentials from GOOGLE_APPLICATION_CREDENTIALS below.
# Optional alternative path:
# FIREBASE_SERVICE_ACCOUNT_PATH=config/firebase-service-account.json
# GOOGLE_APPLICATION_CREDENTIALS=server/config/firebase-service-account.json

FIREBASE_PROJECT_ID=capstoneproject-client
# Optional alternatives to the service account file; use a matching email and key together.
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@capstoneproject-client.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=capstoneproject-client.firebasestorage.app
FIREBASE_WEB_API_KEY=AIzaSyD_9_THiwlQdG3PUSQOk9SElIwc5b0AiI4

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=12h
OTP_TICKET_SECRET=replace_with_a_second_long_random_secret
OTP_TICKET_EXPIRES_IN=10m
OTP_HASH_SECRET=replace_with_a_third_long_random_secret
PASSWORD_HASH_PEPPER=replace_with_a_fourth_long_random_secret
PASSWORD_RESET_URL=http://localhost:5173/reset-password
EMAIL_VERIFICATION_URL=http://localhost:5173/activate-account
FRONTEND_URL=http://localhost:5173

OTP_TTL_MINUTES=5
OTP_CODE_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_TTL_MINUTES=30

# Registration, login and active-session checks restrict VPN/proxy/hosting only outside SEA and Hong Kong.
# Configure the backend API key to receive the full ipapi.is security response.
MAX_ACCOUNTS_PER_IP=2
FRAUD_GEO_LOOKUP_URL=https://api.ipapi.is/?q={ip}&key={api_key}
FRAUD_GEO_LOOKUP_API_KEY=your_ipapi_is_api_key
# Provider errors and unknown geography always fail open, including these ranges.
# Optional verified VPN/hosting CIDRs apply only outside the regional whitelist.
SESSION_BLOCKED_NETWORK_CIDRS=
# Example with a plan that includes threat detection:
# FRAUD_GEO_LOOKUP_URL=https://ipwhois.pro/{ip}?key={api_key}&security=1
EMAIL_VALIDATION_API_URL=
EMAIL_VALIDATION_API_KEY=
# This flag controls email validation and account limits, not connection enforcement.
FRAUD_FAIL_CLOSED=false
HUGGINGFACE_API_KEY=
HUGGINGFACE_PET_IMAGE_MODEL=google/vit-base-patch16-224

MAIL_DELIVERY_MODE=smtp
EMAIL_USER=charmingfurfectionpetcare2@gmail.com
# Paste the 16-character Gmail App Password without spaces. The loader also strips spaces safely.
EMAIL_PASS=your_16_character_gmail_app_password
EMAIL_FROM=charmingfurfectionpetcare2@gmail.com
EMAIL_FROM_NAME=Charming Fur-fection Pet Care

# Optional explicit SMTP overrides. Gmail works without these defaults.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_FROM_NAME=Charming Fur-fection Pet Care
# SMTP_FROM_EMAIL=charmingfurfectionpetcare2@gmail.com
GOOGLE_APPLICATION_CREDENTIALS=server/config/firebase-service-account.json
